# Spark 4.1.3: tag trơn `apache/spark:4.1.3` = biến thể python3 (cùng digest với
# `4.1.3-python3`): Java 17, Scala 2.13, Python 3, pyspark==4.1.3 cài sẵn.
# Ở đây bổ sung pandas/pyarrow (pandas UDF) + pyyaml (common/config.py), rồi bake
# code job + config.yaml vào image để mọi container (master/worker) dùng chung.
FROM apache/spark:4.1.3

USER root

# --break-system-packages là fallback cho base Ubuntu 24.04 (PEP 668);
# các phiên bản pinned có wheel cho Python 3.10-3.13.
RUN python3 -m pip install --no-cache-dir --disable-pip-version-check \
        "pandas==2.2.3" "pyarrow==19.0.0" "pyyaml==6.0.2" \
 || python3 -m pip install --no-cache-dir --disable-pip-version-check \
        --break-system-packages "pandas==2.2.3" "pyarrow==19.0.0" "pyyaml==6.0.2" \
 && rm -rf /root/.cache

# ---- Connector Kafka nhúng sẵn trong image (chạy thí nghiệm không cần `spark-submit --packages`) ----
# User `spark` có HOME=/nonexistent nên Ivy không tạo được cache mặc định. Cách `spark-shell --packages`
# chạy được nhưng thoát mã 1 khi nhận ':quit' từ stdin (build fail), nên tải THẲNG từ Maven Central
# đúng bộ jar mà Spark 4.1.3 dùng (Ivy resolve ra: spark-sql-kafka 4.1.3, token-provider 4.1.3,
# kafka-clients 3.9.1, commons-pool2 2.12.1), rồi chỉ chép jar CHƯA có trong /opt/spark/jars.
RUN mkdir -p /tmp/kafka-conn && cd /tmp/kafka-conn \
 && python3 -c "import urllib.request as u; \
base='https://repo1.maven.org/maven2/'; \
files=['org/apache/spark/spark-sql-kafka-0-10_2.13/4.1.3/spark-sql-kafka-0-10_2.13-4.1.3.jar', \
'org/apache/spark/spark-token-provider-kafka-0-10_2.13/4.1.3/spark-token-provider-kafka-0-10_2.13-4.1.3.jar', \
'org/apache/kafka/kafka-clients/3.9.1/kafka-clients-3.9.1.jar', \
'org/apache/commons/commons-pool2/2.12.1/commons-pool2-2.12.1.jar']; \
[u.urlretrieve(base+f, f.rsplit('/',1)[1]) for f in files]" \
 && for j in *.jar; do [ -e "/opt/spark/jars/$j" ] || cp -f "$j" /opt/spark/jars/; done \
 && cd / && rm -rf /tmp/kafka-conn \
 && chown -R 185:185 /opt/spark/jars \
 && test -f /opt/spark/jars/spark-sql-kafka-0-10_2.13-4.1.3.jar \
 && ls -l /opt/spark/jars/spark-sql-kafka-0-10_2.13-4.1.3.jar \
         /opt/spark/jars/spark-token-provider-kafka-0-10_2.13-4.1.3.jar \
         /opt/spark/jars/kafka-clients-*.jar /opt/spark/jars/commons-pool2-*.jar

# Mã nguồn job + config.yaml (nguồn duy nhất của mọi tham số, README mục 4)
COPY common /opt/p3/common
COPY spark_job /opt/p3/spark_job
COPY config.yaml /opt/p3/config.yaml

# /checkpoints: được bind-mount từ ./checkpoints của repo trên CẢ master và worker
# (Spark cluster-mode cần thư mục dùng chung; bind-mount cùng host-dir => chia sẻ được)
RUN mkdir -p /checkpoints /results \
 && chown -R 185:185 /checkpoints /results /opt/p3

# Base image dùng user spark (uid 185)
USER 185
WORKDIR /opt/p3

ENV P3_CONFIG=/opt/p3/config.yaml \
    P3_SPARK_PACKAGES="org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3" \
    PYSPARK_PYTHON=python3
